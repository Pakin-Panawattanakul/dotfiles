set $mod Mod4
set $meh Mod1+Control+Shift
set $modshift Mod1+Shift
# Vim-like motions
set $left h
set $down j
set $up k
set $right l

########################################
# Default applications
########################################
set $term foot
set $web-browser firefox
set $filemanager thunar
