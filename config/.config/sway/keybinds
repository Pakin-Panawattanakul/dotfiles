#bindsym $mod+Shift+b exec '[ "$(swaymsg -t get_bar_config bar-0 | jq -r ".mode")" = "dock" ] && swaymsg bar mode invisible || swaymsg bar mode dock'

# rofi
bindsym $mod+d exec rofi -show-icons -show drun
bindsym $mod+Shift+q exec wmenu-powermenu -i
bindsym Print exec /home/pakin/.local/bin/sway-rofi-screenshot
bindsym Mod1+tab exec rofi -show-icons -show window 

